# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=0
LOG_LEVEL=info
# Timezone used for due dates and monthly reports (IANA name)
TZ=Asia/Kolkata

# --- Database -----------------------------------------------------------------
# A replica set is recommended (enables multi-document transactions):
#   - `npm run db:memory` starts a local single-node replica set on port 27017
#   - MongoDB Atlas connection strings are replica sets already
MONGODB_URI=mongodb://127.0.0.1:27017/book_management?replicaSet=rs0

# --- Authentication -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- Rate limiting ----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
# Failed login attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=10

# --- Initial library settings (editable later in Settings, ADMIN only) ----------------
LIBRARY_NAME=City Central Library
DEFAULT_CURRENCY=INR
DEFAULT_FINE_PER_DAY=5
DEFAULT_LOAN_PERIOD_DAYS=14
DEFAULT_BORROWING_LIMIT=3
